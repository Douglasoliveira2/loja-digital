# Copie para .env e ajuste. Nunca versione o .env.
NODE_ENV=development
APP_URL=http://localhost:3000

# Banco (desenvolvimento local com docker-compose)
DATABASE_URL=postgresql://loja:loja_dev_local@localhost:5432/loja

# Provedor de pagamento: "simulado" (só desenvolvimento e testes) ou "pagarme".
# Em produção, "simulado" é recusado na inicialização.
PAYMENT_PROVIDER=simulado

# Pagar.me (preencher quando houver credenciais; ver docs)
PAGARME_SECRET_KEY=
PAGARME_WEBHOOK_SECRET=

# Armazenamento privado compatível com S3 (Fase 3 e 6)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
